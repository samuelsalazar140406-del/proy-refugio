---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Brand from '../../components/layout/Brand.astro';
---
<BaseLayout title="Panel | Refugio">
  <div class="min-h-screen bg-shell">
    <header class="border-b border-ink/10 bg-white px-5 py-4 lg:px-10">
      <div class="mx-auto flex max-w-7xl items-center justify-between"><Brand /><div class="flex items-center gap-4"><span class="hidden text-right sm:block"><strong class="block text-xs text-ink">Samuel14</strong><small class="text-[0.65rem] text-ink/45">Administrador</small></span><button id="logout-button" class="rounded-full border border-ink/10 px-4 py-2 text-[0.65rem] font-extrabold uppercase tracking-[0.12em] text-ink transition hover:border-red-200 hover:text-red-600">Salir</button></div></div>
    </header>
    <main class="mx-auto max-w-7xl px-5 py-10 lg:px-10 lg:py-16">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end"><div><p class="eyebrow text-lagoon">Panel de control</p><h1 class="mt-3 font-display text-5xl leading-none text-ink sm:text-6xl">Las historias<br /><em class="text-lagoon">a nuestro cuidado.</em></h1></div><button id="new-animal-button" class="pill-button bg-lagoon text-white hover:bg-ink">+ Registrar animal</button></div>
      <section class="mt-12 rounded-[2rem] border border-ink/5 bg-white p-5 shadow-sm sm:p-7"><div class="flex flex-col justify-between gap-5 lg:flex-row lg:items-end"><div><p class="eyebrow text-ink/45">Explorar registros</p><h2 class="mt-2 font-display text-3xl text-ink">Todos los animales</h2></div><form id="filters-form" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4"><input class="field" name="nombre" placeholder="Buscar por nombre" /><input class="field" name="raza" placeholder="Buscar por raza" /><select class="field" name="sexo"><option value="">Todos los sexos</option><option>Hembra</option><option>Macho</option></select><select class="field" name="tipoAnimal"><option value="">Perros y gatos</option><option>Perro</option><option>Gato</option></select></form></div><div id="animals-status" class="mt-8 hidden rounded-2xl px-4 py-3 text-sm font-semibold"></div><div id="animals-grid" class="mt-8 grid gap-5 sm:grid-cols-2 xl:grid-cols-3"></div></section>
    </main>
  </div>

  <div id="animal-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-ink/60 px-5 py-6 backdrop-blur-sm">
    <div class="max-h-[92vh] w-full max-w-lg overflow-y-auto rounded-[2rem] bg-shell p-6 sm:p-8" role="dialog" aria-modal="true" aria-labelledby="modal-title"><div class="flex items-start justify-between"><div><p class="eyebrow text-lagoon">Ficha animal</p><h2 id="modal-title" class="mt-2 font-display text-4xl text-ink">Nuevo registro</h2></div><button id="close-modal" class="grid h-9 w-9 place-items-center rounded-full bg-white text-ink" aria-label="Cerrar">×</button></div><form id="animal-form" class="mt-8 space-y-4"><div class="grid gap-4 sm:grid-cols-2"><label><span class="mb-2 block text-xs font-bold text-ink/60">Nombre</span><input class="field" name="nombre" required /></label><label><span class="mb-2 block text-xs font-bold text-ink/60">Raza</span><input class="field" name="raza" required /></label><label><span class="mb-2 block text-xs font-bold text-ink/60">Edad</span><input class="field" name="edad" type="number" min="0" required /></label><label><span class="mb-2 block text-xs font-bold text-ink/60">Sexo</span><select class="field" name="sexo"><option value="Hembra">Hembra</option><option value="Macho">Macho</option></select></label><label class="sm:col-span-2"><span class="mb-2 block text-xs font-bold text-ink/60">Tipo de animal</span><select class="field" name="tipoAnimal"><option value="Perro">Perro</option><option value="Gato">Gato</option></select></label></div><p id="form-error" class="hidden rounded-2xl bg-red-50 px-4 py-3 text-sm font-semibold text-red-700"></p><div class="flex justify-end gap-3 pt-3"><button id="cancel-modal" type="button" class="pill-button border border-ink/15 text-ink hover:bg-white">Cancelar</button><button class="pill-button bg-marigold text-ink hover:bg-lagoon hover:text-white" type="submit">Guardar ficha</button></div></form></div>
  </div>
  <script src="../../scripts/admin.ts"></script>
</BaseLayout>
