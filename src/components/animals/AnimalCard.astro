---
import type { Animal } from '../../types/animal';
const { animal } = Astro.props as { animal: Animal };
const isDog = animal.tipoanimal === 'Perro';
---
<article class="group overflow-hidden rounded-[2rem] border border-ink/5 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-float">
  <div class={`relative h-32 overflow-hidden p-5 ${isDog ? 'bg-lagoon' : 'bg-marigold'}`}>
    <span class={`absolute right-4 top-4 rounded-full px-3 py-1 text-[0.6rem] font-extrabold uppercase tracking-[0.14em] ${isDog ? 'bg-white/15 text-white' : 'bg-ink/10 text-ink'}`}>{animal.tipoanimal}</span>
    <span class="absolute -bottom-5 left-5 grid h-16 w-16 place-items-center rounded-2xl bg-white text-3xl shadow-lg">{isDog ? '🐶' : '🐱'}</span>
  </div>
  <div class="p-5 pt-8">
    <div class="flex items-start justify-between gap-3">
      <div><h3 class="font-display text-2xl leading-none text-ink">{animal.nombre}</h3><p class="mt-1 text-xs font-semibold text-ink/50">{animal.raza}</p></div>
      <span class="rounded-full bg-shell px-2.5 py-1 text-xs font-bold text-ink/60">{animal.edad} {animal.edad === 1 ? 'ano' : 'anos'}</span>
    </div>
    <div class="mt-5 flex items-center justify-between border-t border-ink/10 pt-3 text-xs text-ink/55">
      <span>{animal.sexo}</span>
      <span>{new Date(animal.fechaingreso).toLocaleDateString('es-MX')}</span>
    </div>
    <button data-edit-animal={animal.identificador} class="mt-4 w-full rounded-xl border border-lagoon/20 py-2.5 text-xs font-extrabold uppercase tracking-[0.12em] text-lagoon transition hover:bg-lagoon hover:text-white">Editar ficha</button>
  </div>
</article>
